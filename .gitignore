# v2 rewrite artifacts
# Room schema exports версионируются: MigrationTestHelper (Robolectric) читает
# 1..N.json как debug-assets; без них миграционные тесты падают на чистом checkout'e
# (DoD плана: schema change = forward migration + schema fixture + test).
!app/schemas/
app/build/
.gradle/
local.properties

# Agent-tool workspaces (session state, worktrees, MCP config) — не исходники
.agents/
.claude/
.worktrees/
.zcode/

# Generated content exports + Windows-артефакт `nul` (redirect-мусор)
/output_it/
/nul
